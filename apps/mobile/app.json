{
  "expo": {
    "name": "PulseDesk",
    "slug": "pulsedesk",
    "scheme": "pulsedesk",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pulsedesk.mobile"
    },
    "android": {
      "package": "com.pulsedesk.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0aa8d6"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "PulseDesk needs access to your photos to attach a screenshot to a ticket.",
          "cameraPermission": "PulseDesk needs access to your camera to attach a photo to a ticket."
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
