{
  "name": "pulsedesk",
  "version": "0.1.0",
  "private": true,
  "description": "AI-triaged support, human-reviewed.",
  "scripts": {
    "dev:backend": "pnpm --filter @pulsedesk/backend dev",
    "dev:frontend": "pnpm --filter @pulsedesk/frontend dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.0"
}
