# Local dev default matches docker-compose.yml; swap for hosted Postgres (e.g. Supabase) in prod
DATABASE_URL="postgresql://pulsedesk:pulsedesk@localhost:5433/pulsedesk?schema=public"
# Used only by `prisma migrate` — same as DATABASE_URL locally; in prod with a pooled
# DATABASE_URL (e.g. Supabase's pgbouncer port), this should point at the unpooled connection.
DIRECT_URL="postgresql://pulsedesk:pulsedesk@localhost:5433/pulsedesk?schema=public"

PORT=4000

# AI provider selection — "gemini" is the only implementation today, kept
# swappable so openai/claude providers can be added later without touching callers
AI_PROVIDER=gemini
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"

# Comma-separated origins allowed to call the API (web dashboard, Expo dev client)
CORS_ORIGIN="http://localhost:3000"

# Signs reviewer login JWTs (web dashboard only) — use a long random value in production
JWT_SECRET="change-me-to-a-long-random-string"
